# EduPath Environment Variables Example
# Copy this file to .env.local for local development. Never commit real credentials.

# Gemini API Configuration (Server-side only)
GEMINI_API_KEY="your-gemini-api-key"
# Configurable Gemini model (e.g., gemini-2.0-flash)
GEMINI_MODEL="gemini-2.0-flash"

# AI Execution Mode: "fixtures" (no LLM calls, uses mock data) or "live" (calls Gemini)
AI_MODE="fixtures"

# Supabase Configuration (Server-side only, service role key must NEVER reach the browser)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Demo Mode: Set to "true" to allow POST /api/demo/reset to clear learner data and re-seed
DEMO_MODE="true"

# Frontend (public): "true" makes the UI use mock API data instead of the real backend.
# Must be "false" (or unset) in production. Use ?mock=loading|error|empty|has-learner|conflict in the URL to force a UI state.
NEXT_PUBLIC_USE_MOCKS="false"
